{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "android",
      "request": "launch",
      "name": "Android: 构建并调试 Demo",
      "preLaunchTask": "Android: 构建 Debug APK",
      "appSrcRoot": "${workspaceFolder}/app/src/main",
      "apkFile": "${workspaceFolder}/app/build/outputs/apk/debug/app-debug.apk",
      "manifestFile": "${workspaceFolder}/app/build/intermediates/merged_manifests/debug/processDebugManifest/AndroidManifest.xml",
      "launchActivity": ".MainActivity"
    }
  ]
}

